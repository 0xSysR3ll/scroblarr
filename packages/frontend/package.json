{
  "name": "@scroblarr/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src && prettier --check \"src/**/*.{ts,tsx,json,css}\"",
    "lint:fix": "eslint src --fix && prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "lint:eslint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "i18n:extract": "i18next-scanner --config i18next-scanner.config.cjs",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@scroblarr/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.0.0",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/validator": "^13.11.10",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint-plugin-i18next": "^6.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.0.0",
    "i18next-scanner": "^4.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.2.0"
  }
}
