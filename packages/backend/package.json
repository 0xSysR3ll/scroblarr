{
  "name": "@scroblarr/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src && prettier --check \"src/**/*.{ts,json}\"",
    "lint:fix": "eslint src --fix && prettier --write \"src/**/*.{ts,json}\"",
    "lint:eslint": "eslint src",
    "lint:eslint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "migration:run": "tsx src/scripts/runMigrations.ts",
    "migration:generate": "tsx ../../node_modules/typeorm/cli.js migration:generate -d typeorm.config.ts",
    "migration:revert": "tsx ../../node_modules/typeorm/cli.js migration:revert -d typeorm.config.ts",
    "seed": "tsx src/scripts/seedDatabase.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@scroblarr/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "js-yaml": "^4.1.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.11.3",
    "puppeteer": "^24.34.0",
    "reflect-metadata": "^0.2.0",
    "sqlite3": "^6.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.17",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xml2js": "^0.6.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.10.9",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/xml2js": "^0.4.14",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.7.0",
    "typescript": "^6.0.0"
  }
}
