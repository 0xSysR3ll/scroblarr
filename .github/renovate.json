{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":timezone(UTC)",
    "group:allNonMajor",
    "schedule:earlyMondays",
    "helpers:pinGitHubActionDigests"
  ],
  "suppressNotifications": ["prEditedNotification", "prIgnoreNotification"],
  "minimumReleaseAge": "7 days",
  "rebaseWhen": "conflicted",
  "automerge": false,
  "semanticCommits": "enabled",
  "labels": ["dependencies"],
  "postUpdateOptions": ["pnpmDedupe"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Docker base images: pin digests and allow major updates",
      "matchManagers": ["dockerfile", "docker-compose"],
      "pinDigests": true
    },
    {
      "description": "Group pnpm and Node (engines) updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["packageManager", "engines"],
      "groupName": "pnpm and lockfile"
    },
    {
      "description": "Group Node.js version updates",
      "matchPackageNames": ["node"],
      "matchManagers": ["dockerfile", "npm"],
      "groupName": "Node.js"
    },
    {
      "description": "Group database-related packages",
      "matchPackageNames": ["pg", "sqlite3", "typeorm"],
      "groupName": "Database"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Label npm updates",
      "matchManagers": ["npm"],
      "addLabels": ["javascript"]
    },
    {
      "description": "Label GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"]
    },
    {
      "description": "Label Docker updates",
      "matchManagers": ["dockerfile", "docker-compose"],
      "addLabels": ["docker"]
    },
    {
      "description": "Semantic commit for npm dependencies",
      "matchManagers": ["npm"],
      "matchPackagePatterns": ["*"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Semantic commit for Node version",
      "matchPackageNames": ["node"],
      "semanticCommitType": "build",
      "semanticCommitScope": "node"
    },
    {
      "description": "Semantic commit for GitHub Actions",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "semanticCommitScope": "actions"
    },
    {
      "description": "Semantic commit for Docker",
      "matchManagers": ["dockerfile", "docker-compose"],
      "semanticCommitType": "build",
      "semanticCommitScope": "docker"
    },
    {
      "description": "Prioritize security fixes",
      "matchJsonata": ["isVulnerabilityAlert = true"],
      "dependencyDashboardApproval": false,
      "automerge": false,
      "addLabels": ["security"]
    }
  ]
}
